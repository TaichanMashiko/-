rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection check endpoint (used at startup)
    match /test/connection {
      allow get: if isSignedIn();
    }

    // Global hardened helper primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoomCode(code) {
      return code is string && code.size() >= 1 && code.size() <= 64 && code.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity Validation Blueprints
    function isValidRoom(data) {
      return data.keys().hasAll(['roomCode', 'teacherUid', 'chatPaused', 'resetEpoch', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['roomCode', 'teacherUid', 'chatPaused', 'resetEpoch', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidRoomCode(data.roomCode)
        && data.teacherUid is string && data.teacherUid.size() <= 128
        && data.chatPaused is bool
        && data.resetEpoch is int && data.resetEpoch >= 0 && data.resetEpoch <= 1000000
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSignal(data, roomId) {
      return data.keys().hasAll(['roomId', 'ownerUid', 'roomTeacherUid', 'terminalId', 'anonId', 'status', 'epoch', 'expiresAtMs', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['roomId', 'ownerUid', 'roomTeacherUid', 'terminalId', 'anonId', 'status', 'epoch', 'expiresAtMs', 'createdAt', 'updatedAt'])
        && data.roomId == roomId
        && isValidRoomCode(data.roomId)
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.roomTeacherUid is string && data.roomTeacherUid.size() >= 1 && data.roomTeacherUid.size() <= 128
        && isValidRoomCode(data.terminalId)
        && data.anonId is string && data.anonId.size() >= 1 && data.anonId.size() <= 48
        && data.status in ['confused', 'understood']
        && data.epoch is int && data.epoch >= 0 && data.epoch <= 1000000
        && data.expiresAtMs is int && data.expiresAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMessage(data, roomId) {
      return data.keys().hasAll(['roomId', 'ownerUid', 'roomTeacherUid', 'terminalId', 'anonId', 'text', 'kind', 'epoch', 'resolved', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['roomId', 'ownerUid', 'roomTeacherUid', 'terminalId', 'anonId', 'text', 'kind', 'epoch', 'resolved', 'createdAt', 'updatedAt'])
        && data.roomId == roomId
        && isValidRoomCode(data.roomId)
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.roomTeacherUid is string && data.roomTeacherUid.size() >= 1 && data.roomTeacherUid.size() <= 128
        && isValidRoomCode(data.terminalId)
        && data.anonId is string && data.anonId.size() >= 1 && data.anonId.size() <= 48
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 140
        && data.kind in ['quick', 'chat']
        && data.epoch is int && data.epoch >= 0 && data.epoch <= 1000000
        && data.resolved is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMute(data, roomId, terminalId) {
      return data.keys().hasAll(['roomId', 'teacherUid', 'terminalId', 'anonId', 'createdAt'])
        && data.keys().hasOnly(['roomId', 'teacherUid', 'terminalId', 'anonId', 'createdAt'])
        && data.roomId == roomId
        && isValidRoomCode(data.roomId)
        && data.teacherUid is string && data.teacherUid.size() >= 1 && data.teacherUid.size() <= 128
        && data.terminalId == terminalId
        && isValidRoomCode(data.terminalId)
        && data.anonId is string && data.anonId.size() >= 1 && data.anonId.size() <= 48
        && data.createdAt is timestamp;
    }

    match /rooms/{roomId} {
      // Only direct room lookup by known roomId; listing all rooms is forbidden
      allow get: if isVerifiedUser() && isValidId(roomId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(roomId)
        && isValidRoom(incoming())
        && incoming().roomCode == roomId
        && incoming().createdBy == request.auth.uid
        && incoming().teacherUid == request.auth.uid
        && incoming().chatPaused == false
        && incoming().resetEpoch == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(roomId)
        && isValidRoom(incoming())
        && incoming().roomCode == existing().roomCode
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().teacherUid == request.auth.uid
        && (
          // Action: Teacher resets confusion counter & ticker
          (incoming().resetEpoch == existing().resetEpoch + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['resetEpoch', 'updatedAt'])) ||
          // Action: Teacher pauses or resumes student chat
          (incoming().diff(existing()).affectedKeys().hasOnly(['chatPaused', 'updatedAt']))
        );

      allow delete: if false;

      match /signals/{signalId} {
        allow get: if isVerifiedUser()
          && isValidId(roomId)
          && isValidId(signalId)
          && (resource == null || existing().ownerUid == request.auth.uid || existing().roomTeacherUid == request.auth.uid);

        allow list: if isVerifiedUser()
          && (resource.data.ownerUid == request.auth.uid || resource.data.roomTeacherUid == request.auth.uid);

        allow create: if isVerifiedUser()
          && isValidId(roomId)
          && isValidId(signalId)
          && isValidSignal(incoming(), roomId)
          && incoming().ownerUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/rooms/$(roomId))
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.teacherUid == incoming().roomTeacherUid
          && incoming().epoch == get(/databases/$(database)/documents/rooms/$(roomId)).data.resetEpoch;

        allow update: if isVerifiedUser()
          && isValidId(roomId)
          && isValidId(signalId)
          && isValidSignal(incoming(), roomId)
          && existing().ownerUid == request.auth.uid
          && incoming().ownerUid == existing().ownerUid
          && incoming().roomId == existing().roomId
          && incoming().roomTeacherUid == existing().roomTeacherUid
          && incoming().terminalId == existing().terminalId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['anonId', 'status', 'epoch', 'expiresAtMs', 'updatedAt'])
          && exists(/databases/$(database)/documents/rooms/$(roomId))
          && incoming().epoch == get(/databases/$(database)/documents/rooms/$(roomId)).data.resetEpoch;

        allow delete: if false;
      }

      match /messages/{messageId} {
        allow get: if isVerifiedUser()
          && isValidId(roomId)
          && isValidId(messageId)
          && (resource == null || existing().ownerUid == request.auth.uid || existing().roomTeacherUid == request.auth.uid);

        allow list: if isVerifiedUser()
          && (resource.data.ownerUid == request.auth.uid || resource.data.roomTeacherUid == request.auth.uid);

        allow create: if isVerifiedUser()
          && isValidId(roomId)
          && isValidId(messageId)
          && isValidMessage(incoming(), roomId)
          && incoming().ownerUid == request.auth.uid
          && incoming().resolved == false
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/rooms/$(roomId))
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.teacherUid == incoming().roomTeacherUid
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.chatPaused == false
          && incoming().epoch == get(/databases/$(database)/documents/rooms/$(roomId)).data.resetEpoch;

        allow update: if isVerifiedUser()
          && isValidId(roomId)
          && isValidId(messageId)
          && isValidMessage(incoming(), roomId)
          && incoming().roomId == existing().roomId
          && incoming().ownerUid == existing().ownerUid
          && incoming().roomTeacherUid == existing().roomTeacherUid
          && incoming().terminalId == existing().terminalId
          && incoming().anonId == existing().anonId
          && incoming().text == existing().text
          && incoming().kind == existing().kind
          && incoming().epoch == existing().epoch
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['resolved', 'updatedAt'])
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.teacherUid == request.auth.uid;

        allow delete: if false;
      }

      match /mutes/{terminalId} {
        allow get: if isVerifiedUser()
          && isValidId(roomId)
          && isValidId(terminalId)
          && (resource == null || existing().teacherUid == request.auth.uid);

        allow list: if isVerifiedUser()
          && resource.data.teacherUid == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(roomId)
          && isValidId(terminalId)
          && isValidMute(incoming(), roomId, terminalId)
          && incoming().teacherUid == request.auth.uid
          && incoming().createdAt == request.time
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.teacherUid == request.auth.uid;

        allow update: if false;

        allow delete: if isVerifiedUser()
          && isValidId(roomId)
          && isValidId(terminalId)
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.teacherUid == request.auth.uid;
      }
    }
  }
}
